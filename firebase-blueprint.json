{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "expert"] },
        "cultureScore": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "TrainingProgress": {
      "title": "Training Progress",
      "description": "Tracks user progress in security training modules",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "moduleId": { "type": "string" },
        "status": { "type": "string", "enum": ["in-progress", "completed"] },
        "score": { "type": "number" },
        "completedAt": { "type": "timestamp" }
      },
      "required": ["userId", "moduleId", "status"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Reported security incidents",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved"] },
        "reportedAt": { "type": "timestamp" }
      },
      "required": ["userId", "type", "status", "reportedAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "User specific application settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sensitivityMode": { "type": "string", "enum": ["standard", "strict", "expert"] },
        "globalSensitivity": { "type": "number" },
        "nlpEnabled": { "type": "boolean" },
        "nlpDepth": { "type": "number" },
        "visualEnabled": { "type": "boolean" },
        "visualTolerance": { "type": "number" },
        "typoEnabled": { "type": "boolean" },
        "typoDistance": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "Scan": {
      "title": "Scan",
      "description": "URL scan results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "contentSnippet": { "type": "string" },
        "isPhishing": { "type": "boolean" },
        "threatLevel": { "type": "string" },
        "confidence": { "type": "number" },
        "indicators": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": "string" },
        "recommendation": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "url", "isPhishing", "timestamp"]
    },
    "SafelistItem": {
      "title": "Safelist Item",
      "description": "A domain marked as safe",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "risk": { "type": "string" },
        "addedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["name", "url", "risk", "addedBy", "timestamp"]
    },
    "ApiKey": {
      "title": "API Key",
      "description": "API keys generated by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "key": { "type": "string" },
        "permissions": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "createdAt": { "type": "string" },
        "lastUsed": { "type": "string" }
      },
      "required": ["userId", "name", "key", "status", "createdAt"]
    },
    "Webhook": {
      "title": "Webhook",
      "description": "Webhook URLs for real-time notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "events": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name", "url", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles"
    },
    "/training_progress/{progressId}": {
      "schema": { "$ref": "#/entities/TrainingProgress" },
      "description": "Collection of user training progress records"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Collection of reported security incidents"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Collection of user settings"
    },
    "/scans/{scanId}": {
      "schema": { "$ref": "#/entities/Scan" },
      "description": "Collection of URL scan results"
    },
    "/safelist/{itemId}": {
      "schema": { "$ref": "#/entities/SafelistItem" },
      "description": "Collection of domains marked as safe"
    },
    "/apiKeys/{keyId}": {
      "schema": { "$ref": "#/entities/ApiKey" },
      "description": "Collection of API keys"
    },
    "/webhooks/{webhookId}": {
      "schema": { "$ref": "#/entities/Webhook" },
      "description": "Collection of Webhooks"
    }
  }
}
